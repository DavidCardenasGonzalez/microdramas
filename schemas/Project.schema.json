{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "planned",
        "pending",
        "ready",
        "stale",
        "rejected"
      ]
    },
    "deps": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "title": {
      "type": "string"
    },
    "profile": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "microdrama",
            "short",
            "series",
            "feature",
            "novel"
          ]
        },
        "episodes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "durationSeconds": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        },
        "language": {
          "type": "string"
        },
        "languageLevel": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "genre": {
          "type": "string"
        },
        "tone": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "multipleOf": 2
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "multipleOf": 2
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pacing": {
          "type": "string"
        },
        "hooks": {
          "type": "string"
        },
        "cliffhangers": {
          "type": "string"
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "style": {
          "type": "string"
        },
        "strictContinuity": {
          "type": "boolean"
        },
        "maxShotSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        },
        "distribution": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "width": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "multipleOf": 2
              },
              "height": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "multipleOf": 2
              }
            },
            "required": [
              "name",
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "format",
        "episodes",
        "durationSeconds",
        "language",
        "audience",
        "genre",
        "tone",
        "width",
        "height",
        "fps",
        "pacing",
        "hooks",
        "cliffhangers",
        "platforms",
        "style",
        "strictContinuity",
        "maxShotSeconds",
        "distribution"
      ],
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "status",
    "deps",
    "title",
    "profile",
    "createdAt"
  ],
  "additionalProperties": false
}
