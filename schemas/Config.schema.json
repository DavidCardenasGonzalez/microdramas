{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ffmpeg": {
      "type": "string"
    },
    "ffprobe": {
      "type": "string"
    },
    "concurrency": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "maxAttempts": {
      "default": 2,
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "pollMs": {
      "default": 30000,
      "type": "integer",
      "minimum": 100,
      "maximum": 9007199254740991
    },
    "timeoutMs": {
      "default": 1800000,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "budget": {
      "default": 0,
      "type": "number",
      "minimum": 0
    },
    "comfy": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "root": {
          "type": "string"
        },
        "python": {
          "type": "string"
        },
        "msrRunner": {
          "type": "string"
        },
        "msrBase": {
          "type": "string"
        },
        "fluxBase": {
          "type": "string"
        },
        "apiWorkflows": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "bindings": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "node": {
                      "type": "string"
                    },
                    "input": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "node",
                    "input"
                  ],
                  "additionalProperties": false
                }
              },
              "verified": {
                "default": false,
                "type": "boolean"
              },
              "minSeconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "maxSeconds": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "path",
              "bindings",
              "verified",
              "minSeconds",
              "maxSeconds"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "url",
        "root",
        "python",
        "msrRunner",
        "msrBase",
        "apiWorkflows"
      ],
      "additionalProperties": false
    },
    "bridge": {
      "default": {
        "model": "seedance_2_0"
      },
      "type": "object",
      "properties": {
        "model": {
          "default": "seedance_2_0",
          "type": "string"
        },
        "catalog": {
          "type": "string"
        }
      },
      "required": [
        "model"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "concurrency",
    "maxAttempts",
    "pollMs",
    "timeoutMs",
    "budget",
    "comfy",
    "bridge"
  ],
  "additionalProperties": false
}
