{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "targetId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "targetVersion": {
      "type": "number"
    },
    "fingerprint": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "sourceSha256": {
      "type": "string"
    },
    "templateSha256": {
      "type": "string"
    },
    "graphFile": {
      "type": "string"
    },
    "authorized": {
      "default": false,
      "type": "boolean"
    },
    "state": {
      "type": "string",
      "enum": [
        "prepared",
        "running",
        "succeeded",
        "failed",
        "uncertain"
      ]
    },
    "attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "remoteId": {
      "type": "string"
    },
    "output": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "targetId",
    "targetVersion",
    "fingerprint",
    "prompt",
    "templateSha256",
    "graphFile",
    "authorized",
    "state",
    "attempts",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
