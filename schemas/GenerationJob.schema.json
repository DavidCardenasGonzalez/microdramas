{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "shotId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "shotVersion": {
      "type": "number"
    },
    "episodeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "sceneId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "package": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string"
        },
        "shotId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "shotVersion": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "strategy": {
          "default": "reference-video",
          "type": "string",
          "enum": [
            "reference-video",
            "i2v",
            "flf2v",
            "t2v",
            "multi-shot"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "negative": {
          "type": "string"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "version": {
                "type": "number"
              },
              "role": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "version",
              "role",
              "file",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "fps": {
          "type": "number"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "simulated": {
          "type": "boolean"
        },
        "parameters": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "generationMode": {
          "type": "string",
          "enum": [
            "h3_fast_ref",
            "h3_motion",
            "seedance",
            "kling",
            "ltx_i2v",
            "h3_reference_to_video"
          ]
        },
        "referencePlan": {
          "type": "object",
          "properties": {
            "references": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "referenceId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                  },
                  "assetId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "identity",
                      "wardrobe",
                      "location",
                      "prop",
                      "composition",
                      "start",
                      "end"
                    ]
                  },
                  "subjectId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                  },
                  "usage": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "referenceId",
                  "role",
                  "usage"
                ],
                "additionalProperties": false
              }
            },
            "subjects": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "subjectId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                  },
                  "characterId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "wardrobe": {
                    "type": "string",
                    "minLength": 1
                  },
                  "referenceIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                    }
                  },
                  "textOnlyReason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "subjectId",
                  "description",
                  "wardrobe",
                  "referenceIds"
                ],
                "additionalProperties": false
              }
            },
            "shots": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                  },
                  "beatIds": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                    }
                  },
                  "inSeconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "outSeconds": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "transition": {
                    "type": "string",
                    "enum": [
                      "start",
                      "hard-cut"
                    ]
                  },
                  "composition": {
                    "type": "string",
                    "minLength": 1
                  },
                  "action": {
                    "type": "string",
                    "minLength": 1
                  },
                  "camera": {
                    "type": "string",
                    "minLength": 1
                  },
                  "continuity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "visibleSubjectIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                    }
                  },
                  "dramaticPurpose": {
                    "type": "string",
                    "minLength": 1
                  },
                  "performance": {
                    "type": "string",
                    "minLength": 1
                  },
                  "cutReason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "playback": {
                    "type": "string",
                    "enum": [
                      "real-time",
                      "slow-motion"
                    ]
                  },
                  "playbackReason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "beatIds",
                  "inSeconds",
                  "outSeconds",
                  "transition",
                  "composition",
                  "action",
                  "camera",
                  "continuity"
                ],
                "additionalProperties": false
              }
            },
            "dialogueStaging": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "beatId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                  },
                  "speakerId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                  },
                  "shotId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                  },
                  "strategy": {
                    "type": "string",
                    "enum": [
                      "on-camera",
                      "offscreen-audio",
                      "reaction-audio"
                    ]
                  },
                  "lipSync": {
                    "type": "string",
                    "enum": [
                      "required",
                      "none"
                    ]
                  },
                  "inSeconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "outSeconds": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1
                  },
                  "language": {
                    "type": "string",
                    "minLength": 1
                  },
                  "intent": {
                    "type": "string",
                    "minLength": 1
                  },
                  "timingReason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "beatId",
                  "speakerId",
                  "shotId",
                  "strategy",
                  "lipSync",
                  "inSeconds",
                  "outSeconds",
                  "rationale"
                ],
                "additionalProperties": false
              }
            },
            "retentionAnalysis": {
              "type": "string",
              "minLength": 1
            },
            "continuityRequirements": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "expectedOutput": {
              "type": "string",
              "minLength": 1
            },
            "validationCriteria": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "references",
            "subjects",
            "shots",
            "retentionAnalysis",
            "continuityRequirements",
            "expectedOutput",
            "validationCriteria"
          ],
          "additionalProperties": false
        },
        "structuredPrompt": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "adapter",
        "shotId",
        "shotVersion",
        "strategy",
        "prompt",
        "negative",
        "references",
        "durationSeconds",
        "width",
        "height",
        "fps",
        "seed",
        "simulated",
        "parameters"
      ],
      "additionalProperties": false
    },
    "fingerprint": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "uncertain",
        "blocked",
        "stale"
      ]
    },
    "attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxAttempts": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "estimate": {
      "type": "number",
      "minimum": 0
    },
    "paid": {
      "type": "boolean"
    },
    "reserved": {
      "default": false,
      "type": "boolean"
    },
    "remoteId": {
      "type": "string"
    },
    "output": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "shotId",
    "shotVersion",
    "episodeId",
    "sceneId",
    "package",
    "fingerprint",
    "state",
    "attempts",
    "maxAttempts",
    "estimate",
    "paid",
    "reserved",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
