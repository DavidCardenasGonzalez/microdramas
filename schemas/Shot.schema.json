{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "planned",
        "pending",
        "ready",
        "stale",
        "rejected"
      ]
    },
    "deps": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "scriptId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "sceneId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "episodeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "beatIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      }
    },
    "characterIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      }
    },
    "referenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      }
    },
    "assetIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      }
    },
    "purpose": {
      "type": "string"
    },
    "durationReason": {
      "type": "string",
      "minLength": 1
    },
    "framing": {
      "type": "string"
    },
    "camera": {
      "type": "object",
      "properties": {
        "position": {
          "type": "string"
        },
        "movement": {
          "type": "string"
        },
        "lens": {
          "type": "string"
        },
        "focus": {
          "type": "string"
        }
      },
      "required": [
        "position",
        "movement",
        "lens",
        "focus"
      ],
      "additionalProperties": false
    },
    "blocking": {
      "type": "string"
    },
    "startState": {
      "type": "string"
    },
    "endState": {
      "type": "string"
    },
    "durationSeconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "continuity": {
      "type": "object",
      "properties": {
        "axis": {
          "type": "string"
        },
        "eyelines": {
          "type": "string"
        },
        "wardrobe": {
          "type": "string"
        },
        "props": {
          "type": "string"
        },
        "lighting": {
          "type": "string"
        }
      },
      "required": [
        "axis",
        "eyelines",
        "wardrobe",
        "props",
        "lighting"
      ],
      "additionalProperties": false
    },
    "dialogue": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "speakerId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "text": {
            "type": "string"
          },
          "beatId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          }
        },
        "required": [
          "speakerId",
          "text",
          "beatId"
        ],
        "additionalProperties": false
      }
    },
    "sound": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "previousShotId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "nextShotId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "generationMode": {
      "type": "string",
      "enum": [
        "h3_fast_ref",
        "h3_motion",
        "seedance",
        "kling",
        "ltx_i2v",
        "h3_reference_to_video"
      ]
    },
    "routingReason": {
      "type": "string",
      "minLength": 1
    },
    "referencePlan": {
      "type": "object",
      "properties": {
        "references": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "referenceId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "assetId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "role": {
                "type": "string",
                "enum": [
                  "identity",
                  "wardrobe",
                  "location",
                  "prop",
                  "composition",
                  "start",
                  "end"
                ]
              },
              "subjectId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "usage": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "referenceId",
              "role",
              "usage"
            ],
            "additionalProperties": false
          }
        },
        "subjects": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subjectId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "characterId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "wardrobe": {
                "type": "string",
                "minLength": 1
              },
              "referenceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                }
              },
              "textOnlyReason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "subjectId",
              "description",
              "wardrobe",
              "referenceIds"
            ],
            "additionalProperties": false
          }
        },
        "shots": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "beatIds": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                }
              },
              "inSeconds": {
                "type": "number",
                "minimum": 0
              },
              "outSeconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "transition": {
                "type": "string",
                "enum": [
                  "start",
                  "hard-cut"
                ]
              },
              "composition": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "minLength": 1
              },
              "camera": {
                "type": "string",
                "minLength": 1
              },
              "continuity": {
                "type": "string",
                "minLength": 1
              },
              "visibleSubjectIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                }
              },
              "dramaticPurpose": {
                "type": "string",
                "minLength": 1
              },
              "performance": {
                "type": "string",
                "minLength": 1
              },
              "cutReason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "beatIds",
              "inSeconds",
              "outSeconds",
              "transition",
              "composition",
              "action",
              "camera",
              "continuity"
            ],
            "additionalProperties": false
          }
        },
        "dialogueStaging": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "beatId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "speakerId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "shotId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "strategy": {
                "type": "string",
                "enum": [
                  "on-camera",
                  "offscreen-audio",
                  "reaction-audio"
                ]
              },
              "lipSync": {
                "type": "string",
                "enum": [
                  "required",
                  "none"
                ]
              },
              "inSeconds": {
                "type": "number",
                "minimum": 0
              },
              "outSeconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "beatId",
              "speakerId",
              "shotId",
              "strategy",
              "lipSync",
              "inSeconds",
              "outSeconds",
              "rationale"
            ],
            "additionalProperties": false
          }
        },
        "retentionAnalysis": {
          "type": "string",
          "minLength": 1
        },
        "continuityRequirements": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expectedOutput": {
          "type": "string",
          "minLength": 1
        },
        "validationCriteria": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "references",
        "subjects",
        "shots",
        "retentionAnalysis",
        "continuityRequirements",
        "expectedOutput",
        "validationCriteria"
      ],
      "additionalProperties": false
    },
    "direction": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "genre": {
          "type": "string",
          "minLength": 1
        },
        "dramaticObjective": {
          "type": "string",
          "minLength": 1
        },
        "turn": {
          "type": "string",
          "minLength": 1
        },
        "audienceExperience": {
          "type": "string",
          "minLength": 1
        },
        "visualTreatment": {
          "type": "string",
          "minLength": 1
        },
        "coverageReason": {
          "type": "string",
          "minLength": 1
        },
        "singleShotReason": {
          "type": "string",
          "minLength": 1
        },
        "characters": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "characterId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "objective": {
                "type": "string",
                "minLength": 1
              },
              "obstacle": {
                "type": "string",
                "minLength": 1
              },
              "subtext": {
                "type": "string",
                "minLength": 1
              },
              "emotionalProgression": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "characterId",
              "objective",
              "obstacle",
              "subtext",
              "emotionalProgression"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "genre",
        "dramaticObjective",
        "turn",
        "audienceExperience",
        "visualTreatment",
        "coverageReason",
        "characters"
      ],
      "additionalProperties": false
    },
    "beatType": {
      "type": "string",
      "enum": [
        "DIALOGUE",
        "CONTROLLED_ACTION",
        "DYNAMIC_ACTION",
        "COMPLEX_TRANSITION"
      ]
    },
    "sequenceContinuity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "escalationReason": {
      "type": "string",
      "minLength": 1
    },
    "strategy": {
      "default": "reference-video",
      "type": "string",
      "enum": [
        "reference-video",
        "i2v",
        "flf2v",
        "t2v",
        "multi-shot"
      ]
    },
    "selectedTakeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "finalState": {
      "default": "planned",
      "type": "string",
      "enum": [
        "planned",
        "generated",
        "selected",
        "edited",
        "stale"
      ]
    }
  },
  "required": [
    "id",
    "version",
    "status",
    "deps",
    "scriptId",
    "sceneId",
    "episodeId",
    "beatIds",
    "characterIds",
    "referenceIds",
    "assetIds",
    "purpose",
    "framing",
    "camera",
    "blocking",
    "startState",
    "endState",
    "durationSeconds",
    "continuity",
    "dialogue",
    "sound",
    "strategy",
    "finalState"
  ],
  "additionalProperties": false
}
