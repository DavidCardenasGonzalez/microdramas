{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "stage": {
      "type": "string"
    },
    "targetId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "blocker"
      ]
    },
    "message": {
      "type": "string"
    },
    "resolution": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "stage",
    "severity",
    "message",
    "resolution",
    "createdAt"
  ],
  "additionalProperties": false
}
