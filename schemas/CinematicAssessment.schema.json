{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "viewedVideo": {
      "type": "boolean",
      "const": true
    },
    "listenedAudio": {
      "type": "boolean",
      "const": true
    },
    "samples": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "atSeconds": {
            "type": "number",
            "minimum": 0
          },
          "observation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "atSeconds",
          "observation"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "verdict": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "not-applicable"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "verdict",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "viewedVideo",
    "listenedAudio",
    "samples",
    "checks"
  ],
  "additionalProperties": false
}
