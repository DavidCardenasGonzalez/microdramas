{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "planned",
        "pending",
        "ready",
        "stale",
        "rejected"
      ]
    },
    "deps": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "sceneId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "canonicalText": {
      "type": "string",
      "minLength": 1
    },
    "set": {
      "type": "string",
      "minLength": 1
    },
    "spatialMap": {
      "type": "string",
      "minLength": 1
    },
    "axis": {
      "type": "string",
      "minLength": 1
    },
    "lighting": {
      "type": "string",
      "minLength": 1
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "characterId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "wardrobe": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "string",
            "minLength": 1
          },
          "voice": {
            "type": "string",
            "minLength": 1
          },
          "physicalState": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "characterId",
          "wardrobe",
          "position",
          "voice",
          "physicalState"
        ],
        "additionalProperties": false
      }
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "minLength": 1
          },
          "ownerId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          }
        },
        "required": [
          "name",
          "state"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "version",
    "status",
    "deps",
    "sceneId",
    "canonicalText",
    "set",
    "spatialMap",
    "axis",
    "lighting",
    "characters",
    "props"
  ],
  "additionalProperties": false
}
